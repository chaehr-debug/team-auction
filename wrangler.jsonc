{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "team-auction",
  "main": "src/worker.js",
  // public/streamers/ 사진 목록 → src/streamer-images.js (dev / deploy 때마다 자동 생성)
  "build": { "command": "node tools/build-streamers.js", "watch_dir": "public/streamers" },
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // 아래 경로는 Worker 코드가 먼저 처리, 나머지는 정적 파일
    "run_worker_first": ["/api/*", "/ws/*", "/r/*", "/overlay/*", "/uploads/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "AuctionRoom" },
      { "name": "IMAGES", "class_name": "ImageStore" },
      { "name": "STATS", "class_name": "StatsStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AuctionRoom", "ImageStore"] },
    { "tag": "v2", "new_sqlite_classes": ["StatsStore"] }
  ],
  "observability": { "enabled": true }
}
